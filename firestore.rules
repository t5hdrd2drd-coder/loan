rules_version = '2';
// Prototype rules. Full schema and trust boundaries: docs/DATA.md.
// loans/{id}: schemaVersion/int, id/string, name/string(1..100),
// annualRate/number(0..10), status/active|closed, version/int(>=1),
// deletedAt/null|ISO string, shareToken/null|192-bit hex, events/list(1..1500).
// Each event: id/string, date/YYYY-MM-DD, type/enum, amountCents/int,
// order/int, note/string(<=500). Date-only strings preserve existing history.
// shares/{token}: public projection containing only schemaVersion, name,
// annualRate, status, version, active/bool and events with empty notes.
// Only the fixed administrator may write either collection. No user roles
// can be created or escalated by client-written documents.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      // Replace with the same UID as src/config.js. Fail closed until configured.
      return request.auth != null && request.auth.uid == 'hjX3f66yfQOzWy51NQtC5AXmXdP2';
    }
    function validCommon(data) {
      return data.keys().hasAll(['schemaVersion','name','annualRate','status','version','events'])
        && data.schemaVersion == 2
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.annualRate is number && data.annualRate >= 0 && data.annualRate <= 10
        && data.status in ['active','closed']
        && data.version is int && data.version > 0
        && data.events is list && data.events.size() > 0 && data.events.size() <= 1500;
    }
    function validEvent(event) {
      return event is map
        && event.keys().hasAll(['id','date','type','amountCents','order','note'])
        && event.keys().hasOnly(['id','date','type','amountCents','order','note'])
        && event.id is string && event.id.size() > 0 && event.id.size() <= 100
        && event.date is string && event.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && event.type in ['borrow','repay','interest','waive','checkpoint']
        && event.amountCents is int && event.amountCents >= 0 && event.amountCents <= 100000000000
        && ((event.type == 'checkpoint' && event.amountCents == 0) || (event.type != 'checkpoint' && event.amountCents > 0))
        && event.order is int && event.order >= 0
        && event.note is string && event.note.size() <= 500;
    }
    function validLoan(data, loanId) {
      return validCommon(data)
        && data.keys().hasAll(['id','deletedAt','shareToken'])
        && data.keys().hasOnly(['schemaVersion','id','name','annualRate','status','version','deletedAt','shareToken','events'])
        && data.id == loanId && data.id.matches('^[A-Za-z0-9_-]{1,100}$')
        && (data.deletedAt == null || (data.deletedAt is string && data.deletedAt.size() <= 35))
        && (data.shareToken == null || (data.shareToken is string && data.shareToken.matches('^[a-f0-9]{48}$')))
        && validEvent(data.events[0]) && validEvent(data.events[data.events.size()-1]);
    }
    function validShare(data) {
      return validCommon(data)
        && data.keys().hasAll(['active'])
        && data.keys().hasOnly(['schemaVersion','name','annualRate','status','version','active','events'])
        && data.active is bool
        && validEvent(data.events[0]) && validEvent(data.events[data.events.size()-1])
        && data.events[0].note == '' && data.events[data.events.size()-1].note == '';
    }
    // Rules cannot iterate an arbitrary-length event array. These checks bound
    // the array and validate its endpoints. The trusted owner's application
    // validates EVERY event and strips ALL notes from projections before writes.
    // Future untrusted editors would require per-event documents/server validation.
    match /loans/{loanId} {
      allow read, delete: if owner();
      allow create: if owner() && validLoan(request.resource.data, loanId)
        && request.resource.data.version == 1;
      allow update: if owner() && validLoan(request.resource.data, loanId)
        && request.resource.data.version == resource.data.get('version', 0) + 1;
    }
    match /shares/{token} {
      // Explicitly authorized by the owner: bearer-link read access, get only.
      allow get: if owner() || (token.matches('^[a-f0-9]{48}$') && resource.data.active == true);
      allow list: if false;
      allow create, update: if owner() && token.matches('^[a-f0-9]{48}$') && validShare(request.resource.data);
      allow delete: if owner();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
